<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scroll_contenu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="64dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tv_titre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_contexte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/ll_formulaire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Barre de validation FIXE (hors scroll) : sur un long formulaire, le bouton
             d'enregistrement restait invisible tant qu'on n'avait pas défilé jusqu'en bas —
             risque de visite « crue enregistrée ». Toujours visible désormais. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?attr/colorSurface"
            android:elevation="8dp">

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enregistrer la visite" />

            <!-- Bouton "Terminer" : visible UNIQUEMENT en mode "chaîne de saisies" (= quand
                 le parent est lui-même un type de saisie type visite, donc on enchaîne
                 plusieurs obs sur la même visite). Pour sortir du flow et revenir à la
                 fiche du parent. -->
            <Button
                android:id="@+id/btn_terminer"
                style="@style/Widget.GeoMys.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Terminer"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fil d'Ariane flottant : sticky en haut, au-dessus du ScrollView. Bordure arrondie +
         ombre (elevation) pour que l'utilisateur voie nettement le contenu passer dessous. -->
    <TextView
        android:id="@+id/tv_fil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_fil_ariane"
        android:backgroundTint="?attr/colorSurfaceVariant"
        android:elevation="6dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="UnusedAttribute"
        tools:visibility="visible" />

    <!-- Plus de flèche retour : l'icône maison du fil d'Ariane assure le retour. -->
</FrameLayout>