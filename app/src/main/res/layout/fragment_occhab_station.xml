<?xml version="1.0" encoding="utf-8"?>
<!-- Écran habitats d'une station OccHab : liste des habitats (1..N) + bouton « Détails » (haut
     droite) qui ouvre le formulaire des champs de la station (JDD, observateurs, dates…). Le
     jeu de données est saisi via un dialogue au premier passage. Enregistre en local. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête : bandeau navigation (gauche) + coche verte « terminer » (droite, même style
         que la saisie multi-taxons) qui ramène à la carte pour la station suivante. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/bandeau_saisie"
            layout="@layout/view_bandeau_saisie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp" />

        <ImageButton
            android:id="@+id/btn_terminer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Terminer la station"
            android:scaleType="fitCenter"
            android:src="@drawable/coche" />
    </FrameLayout>

    <!-- Titre de l'écran + bouton Détails sur la même ligne (Détails justifié à droite). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nouvelle station"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_details"
            style="@style/Widget.GeoMys.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:paddingHorizontal="16dp"
            android:text="Détails"
            android:textAllCaps="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="?attr/colorControlHighlight" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_geometrie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorControlNormal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_jdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorControlNormal"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="?attr/colorControlHighlight" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Habitats"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/habitats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_aucun_habitat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aucun habitat. Ajoutez-en au moins un."
                android:textColor="?attr/colorControlNormal"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_ajouter_habitat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="＋ Ajouter un autre habitat"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
