<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/bandeau_saisie"
        layout="@layout/view_bandeau_saisie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp" />

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <!-- Plus de flèche retour ni de titre : le bandeau de navigation au-dessus assure
             le retour à l'accueil et le libellé de l'écran. Spacer pour garder le bouton
             « Importer GPX » aligné à droite. -->
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_importer_gpx"
            style="@style/Widget.GeoMys.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importer GPX" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorControlHighlight" />

    <!-- Onglets À envoyer / Envoyés / Importés — fond TRANSPARENT (plus de bande noire de
         TabLayout : le dégradé de l'app traverse), soulignement + texte actif jaune clair.
         Même style sur les trois écrans « Mes X ». -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingHorizontal="8dp"
        app:tabIndicatorColor="@color/jaune_clair"
        app:tabSelectedTextColor="@color/jaune_clair"
        app:tabTextColor="?attr/colorOnSurfaceVariant" />

    <!-- Progression d'envoi INLINE (même patron que « Mes visites ») : remplace l'ancien
         dialogue modal bloquant pendant l'envoi d'une saisie. -->
    <ProgressBar
        android:id="@+id/progress_envoi"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_message_envoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Envoi groupé : transfère d'un coup toutes les saisies encore à envoyer (onglet « À
         envoyer »). Masqué hors de cet onglet, pendant un envoi, ou sans droit de création. -->
    <Button
        android:id="@+id/btn_tout_envoyer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/green_85"
        android:text="Tout envoyer"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <!-- Vue vide -->
    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.3"
            android:contentDescription="@null"
            android:src="@drawable/ic_map" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Aucune saisie enregistrée\nTerminez une saisie pour la sauvegarder."
            android:textColor="?attr/colorControlNormal" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>