<?xml version="1.0" encoding="utf-8"?>
<!-- « Mes stations » OccHab : liste des stations saisies localement, avec envoi/édition/
     suppression par ligne (calqué sur « Mes saisies »). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/bandeau_saisie"
        layout="@layout/view_bandeau_saisie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorControlHighlight" />

    <!-- Fond transparent (plus de bande noire), soulignement jaune — même style que
         « Mes saisies ». -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingHorizontal="8dp"
        app:tabIndicatorColor="@color/jaune_clair"
        app:tabSelectedTextColor="@color/jaune_clair"
        app:tabTextColor="?attr/colorOnSurfaceVariant" />

    <!-- Progression d'envoi INLINE (même patron que « Mes visites ») : remplace l'ancien
         dialogue modal bloquant pendant l'envoi d'une station. -->
    <ProgressBar
        android:id="@+id/progress_envoi"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_message_envoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Envoi groupé : transfère d'un coup toutes les saisies encore à envoyer (onglet « À
         envoyer »). Masqué hors de cet onglet, pendant un envoi, ou sans droit de création. -->
    <Button
        android:id="@+id/btn_tout_envoyer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/green_85"
        android:text="Tout envoyer"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.3"
            android:contentDescription="@null"
            android:src="@drawable/ic_map" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Aucune station enregistrée.\nCréez-en une depuis « OccHab » sur l'accueil."
            android:textColor="?attr/colorControlNormal" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
