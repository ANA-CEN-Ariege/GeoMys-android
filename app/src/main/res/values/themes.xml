<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GeoMys" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Pas de android:statusBarColor : DÉPRÉCIÉ en Android 15 (affichage bord-à-bord) et
             signalé par la console Play. Avec enableEdgeToEdge (MainActivity), la barre de statut
             est déjà transparente par défaut → aucun changement visuel en le retirant. -->
        <!-- windowLightStatusBar=false = icônes de statut CLAIRES (fond accueil sombre) ; NON
             déprécié (contrôle l'apparence, pas la couleur de barre). -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- App de terrain → fond sombre type accueil partout pour optimiser la lisibilité
             en plein soleil. Toutes les fenêtres (Activity + fragments via ?android:
             attr/windowBackground) montrent le dégradé là où la vue est transparente. -->
        <item name="android:windowBackground">@drawable/bg_accueil</item>
    </style>
</resources>