<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <include
            android:id="@+id/bandeau_saisie"
            layout="@layout/view_bandeau_saisie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Plus de flèche retour ni de titre « Saisies en attente » : le bandeau de
             navigation au-dessus assure le retour à l'accueil et le libellé de l'écran. -->

        <TextView
            android:id="@+id/tv_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress_envoi"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_message_envoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Onglets À envoyer / Envoyées — mêmes onglets que « Mes saisies » / « Mes stations ».
             Un GROUPE (racine + descendants) reste dans « À envoyer » tant qu'une de ses données
             n'est pas partie ; la hiérarchie protocole → groupe → lignes est conservée DANS
             chaque onglet. -->
        <!-- Fond transparent (plus de bande noire), soulignement jaune — même style que
             « Mes saisies ». -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/jaune_clair"
            app:tabSelectedTextColor="@color/jaune_clair"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />

        <!-- Envoi groupé : pousse d'un coup TOUTE la file en attente (parent → enfant), en
             s'appuyant sur OutboxEnvoi.envoyerTout. Masqué hors de l'onglet « À envoyer »,
             pendant un envoi, ou si aucun protocole autorisé n'a de donnée en attente. -->
        <Button
            android:id="@+id/btn_tout_envoyer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/green_85"
            android:text="Tout envoyer"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <!-- RecyclerView (recyclage : seules les lignes visibles sont construites), cohérent
             avec « Mes saisies » / « Mes stations ». Remplace l'ancien ScrollView + LinearLayout
             reconstruit intégralement à chaque refresh ; les items (headers protocole/groupe,
             lignes indentées) restent construits par les mêmes fonctions qu'avant. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_saisies"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
